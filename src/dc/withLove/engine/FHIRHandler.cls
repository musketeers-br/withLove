Class dc.withLove.engine.FHIRHandler Extends %RegisteredObject
{

ClassMethod ImportFHIR(pTenantId As %String, pJsonContent As %String) As %DynamicObject
{
    Set tResponse = { "status": "error" }
    Try {
        Set tResource = {}.%FromJSON(pJsonContent)
        Set tResourceType = tResource.resourceType
        
        If (tResourceType = "") {
            Set tResponse.message = "Invalid FHIR: Missing resourceType."
            Return tResponse
        }

        Set tCleanTenant = $ZStrip(pTenantId, "*E", "", "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")
        If tCleanTenant="" Set tCleanTenant = "default"
        
        Set tClassName = "dc.withLove." _ tCleanTenant _ ".data." _ tResourceType
        
        If '##class(%Dictionary.ClassDefinition).%ExistsId(tClassName) {
            Set tResponse.message = "Target Class not found: " _ tClassName _ ". Please ask the Backend Agent to create a '" _ tResourceType _ "' table first."
            Return tResponse
        }

        Set tObj = $ClassMethod(tClassName, "%New")
        
        // Name (Family + Given) -> Name
        If tResource.name.%IsA("%DynamicArray") {
            Set tNameObj = tResource.name.%Get(0)
            Set tFullName = tNameObj.given.%Get(0) _ " " _ tNameObj.family
            If $Method(tObj, "NameSet") Do $Method(tObj, "NameSet", tFullName)
        }
        
        // Gender -> Gender
        If (tResource.gender '= "") {
            If $Method(tObj, "GenderSet") Do $Method(tObj, "GenderSet", tResource.gender)
        }
        
        // BirthDate -> DOB / BirthDate
        If (tResource.birthDate '= "") {
            // Tenta propriedades comuns
            If $Method(tObj, "BirthDateSet") { Do $Method(tObj, "BirthDateSet", tResource.birthDate) }
            ElseIf $Method(tObj, "DOBSet") { Do $Method(tObj, "DOBSet", tResource.birthDate) }
        }

        Set tSC = tObj.%Save()
        
        If $$$ISOK(tSC) {
            Set tResponse.status = "success"
            Set tResponse.message = "FHIR " _ tResourceType _ " imported to SQL Table (ID: " _ tObj.%Id() _ ")."
        } Else {
            Set tResponse.message = "Save Error: " _ $System.Status.GetErrorText(tSC)
        }

    } Catch ex {
        Set tResponse.message = "Exception: " _ ex.DisplayString()
    }
    Return tResponse
}

/// Validates the FHIR JSON generated by AI
ClassMethod ValidateAndProcess(pJsonStream As %Stream.GlobalCharacter) As %DynamicObject
{
    Set tResponse = {}
    
    Try {
        // 1. Parse JSON to ensure syntax validity
        Set tDynamicObj = {}.%FromJSON(pJsonStream)
        
        // 2. Check if it is a Bundle
        If (tDynamicObj.resourceType '= "Bundle") {
            $$$ThrowStatus($$$ERROR($$$GeneralError, "AI generated a " _ tDynamicObj.resourceType _ ", expected a Bundle."))
        }

        // 3. (Optional) Here you would call the Internal FHIR Service to save
        // For the MVP, we return the validated object to show in the UI
        // Example logic to save:
        // Set tSC = ##class(HS.FHIRServer.Service).EnsureInstance(namespace).ProcessBundle(tDynamicObj)
        
        Set tResponse = tDynamicObj
        
    } Catch ex {
        Set tResponse = {
            "resourceType": "OperationOutcome",
            "issue": [{
                "severity": "error",
                "code": "processing",
                "diagnostics": (ex.DisplayString())
            }]
        }
    }
    
    Return tResponse
}

}
